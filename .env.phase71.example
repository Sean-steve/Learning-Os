# Production deploy example only. Never check in real values.
APP_ENV=production
AUTH_REQUIRE_MFA=true
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_A_SECRET_MANAGER
DATABASE_URL=postgres://learning_os_app:REPLACE_SECRET@127.0.0.1:5432/learning_os
WEB_ORIGIN=https://learning.example.com
API_HOST=127.0.0.1
API_PORT=3005
OPENAI_API_KEY=
GOOGLE_CALENDAR_LOCAL_ENABLED=false
# The frontend must be built on the approved HTTPS host with:
# VITE_LEARNING_API_ENABLED=true
# GitHub Pages always uses the static preview with this flag unset.
