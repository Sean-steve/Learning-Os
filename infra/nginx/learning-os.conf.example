# Example only. Replace host, cert paths, install the built frontend and obtain TLS
# certificates before enabling this virtual host. Do not expose Bun/Postgres directly.
server {
  listen 80;
  server_name learning.example.com;
  return 308 https://$host$request_uri;
}
server {
  listen 443 ssl http2;
  server_name learning.example.com;
  ssl_certificate /etc/letsencrypt/live/learning.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/learning.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  root /srv/learning-os/apps/web/dist;
  index index.html;
  client_max_body_size 1m;

  add_header Strict-Transport-Security "max-age=15552000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' blob: https:; worker-src 'self' blob:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

  location /api/ {
    proxy_pass http://127.0.0.1:3005/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_hide_header Server;
  }
  location / {
    try_files $uri $uri/ /index.html;
  }
}
