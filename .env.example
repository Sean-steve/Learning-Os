API_PORT=3005
WEB_ORIGIN=http://localhost:5173
# Phase 1 does not require a database or API keys.

# Optional Bun AI service (NEVER set an API key in Vite variables or Pages)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
API_PORT=3005
WEB_ORIGIN=http://localhost:5173
VITE_LEARNING_API_URL=http://localhost:3005

# Phase 4 — ONLY when developing locally (no secret in Vite vars)
API_HOST=127.0.0.1
GOOGLE_CALENDAR_LOCAL_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/v1/google/callback
# Set WEB_ORIGIN=http://localhost:5173 and configure the OAuth redirect URL in Google Cloud.

# Phase 6: PostgreSQL is required only for the local API, not GitHub Pages
DATABASE_URL=postgres://learning_os:REPLACE_ME@127.0.0.1:5432/learning_os
