# Production example only. Store as /etc/learning-os/api.env with root-owned 0600 permissions.
# Do not commit real values or expose Bun/Postgres directly.
DATABASE_URL=postgres://learning_os_app:REPLACE_ME@127.0.0.1:5432/learning_os
API_HOST=127.0.0.1
API_PORT=3005
WEB_ORIGIN=https://learning.example.com
OPENAI_API_KEY=
GOOGLE_CALENDAR_LOCAL_ENABLED=false
# Compile-time frontend flag on a separate same-origin HTTPS deployment:
# VITE_LEARNING_API_ENABLED=true
# Never enable the backend API flag in the GitHub Pages demo.
